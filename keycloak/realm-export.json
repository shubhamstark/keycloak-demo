{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "default-roles-demo",
        "description": "${role_default-roles}"
      },
      {
        "name": "company-admin",
        "description": "Can manage users, roles, and groups within their own company"
      },
      {
        "name": "tax-filer",
        "description": "Can file and view VAT returns"
      },
      {
        "name": "viewer",
        "description": "Read-only access to company services"
      }
    ]
  },
  "groups": [
    {
      "name": "Acme Admins",
      "path": "/Acme Admins",
      "realmRoles": ["company-admin"]
    },
    {
      "name": "Acme Tax Team",
      "path": "/Acme Tax Team",
      "realmRoles": ["tax-filer"]
    }
  ],
  "organizations": [
    {
      "name": "acme",
      "enabled": true,
      "domains": [
        {
          "name": "acme.com"
        }
      ]
    },
    {
      "name": "globex",
      "enabled": true,
      "domains": [
        {
          "name": "globex.com"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tajir-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://app.demo.local/*"
      ],
      "webOrigins": [
        "http://app.demo.local"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://app.demo.local/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "dashboard-audience"
      ],
      "optionalClientScopes": [
        "offline_access",
        "organization"
      ]
    },
    {
      "clientId": "login-mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://app.demo.local/mobile/*"
      ],
      "webOrigins": [
        "http://app.demo.local"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://app.demo.local/mobile/*",
        "use.refresh.tokens": "true",
        "client.offline.session.idle.timeout": "86400",
        "client.offline.session.max.lifespan": "604800"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "dashboard-audience"
      ],
      "optionalClientScopes": [
        "offline_access",
        "organization"
      ]
    },
    {
      "clientId": "dashboard-service",
      "enabled": true,
      "publicClient": false,
      "secret": "dashboard-service-demo-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "admin-audience"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "admin-service",
      "enabled": true,
      "publicClient": false,
      "secret": "admin-service-demo-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "openid"
      ],
      "optionalClientScopes": [],
      "serviceAccountClientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users",
          "view-clients",
          "query-clients",
          "view-realm",
          "manage-groups",
          "query-groups",
          "view-groups"
        ]
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "web-origins"
  ],
  "defaultOptionalClientScopes": [
    "offline_access"
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "access.token.claim": "true",
            "claim.name": "given_name",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "lastName",
            "access.token.claim": "true",
            "claim.name": "family_name",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "updated at",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "updatedAt",
            "access.token.claim": "true",
            "claim.name": "updated_at",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "access.token.claim": "true",
            "claim.name": "email",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "description": "OpenID Connect scope for allowed web origins",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "config": {}
        }
      ]
    },
    {
      "name": "dashboard-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dashboard-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dashboard-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "admin-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "admin-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "admin-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "organization",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "organization-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "claim.name": "organization"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "shubham",
      "enabled": true,
      "emailVerified": true,
      "email": "shubham@acme.com",
      "firstName": "Shubham",
      "lastName": "Kaushal",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-demo",
        "company-admin"
      ],
      "groups": [
        "Acme Admins"
      ]
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@acme.com",
      "firstName": "Alice",
      "lastName": "Chen",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-demo",
        "tax-filer"
      ],
      "groups": [
        "Acme Tax Team"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@globex.com",
      "firstName": "Bob",
      "lastName": "Singh",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-demo",
        "viewer"
      ]
    }
  ]
}
